{
  "name": "fable-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w packages/demo run dev",
    "build": "npm -w packages/demo run build",
    "preview": "npm -w packages/demo run preview",
    "check:fix": "npx @biomejs/biome check --write .",
    "check": "npm run lint",
    "lint": "echo 'lint placeholder'",
    "lint:tokens": "node scripts/lint-tokens.js",
    "lint:tokens:fix": "node scripts/lint-tokens.js --fix"
  },
  "keywords": [
    "web-components",
    "lit",
    "storybook",
    "components"
  ],
  "author": "@artmsilva",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
